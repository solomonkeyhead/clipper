# data & artifacts (never committed)
data/
out/
eval/report.md
eval_cache/

# secrets
.env
# A Google app built into a packaged copy (clipper youtube bundle, D84).
src/clipper/youtube/app.json
*.key

# python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# downloaded assets (fetched by `clipper doctor --fix` / setup)
assets/fonts/*
!assets/fonts/.gitkeep
assets/models/*
!assets/models/.gitkeep

# Control Center front end: dependencies are installed, not committed. Its
# build (src/clipper/studio/static) IS committed, so running Clipper needs no Node.
node_modules/

# os / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Base Python for .venv, kept outside AppData so Task Scheduler can run it
.python/
campaigns/.history/

# Your campaigns live in data/campaigns (D145); only the template is part of the repo.
/campaigns/*
!/campaigns/example.yaml
