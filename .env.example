# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Default LLM backend (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional paid backend. https://console.anthropic.com/settings/keys
# With it, Create writes scripts and plans diagrams with Claude first (D109),
# billed per use, about $0.30-0.60 a video. Leave empty to stay free.
ANTHROPIC_API_KEY=

# Create's stock footage (free, commercial use, no credit needed). Either or
# both; Pexels has the better footage of people.
# https://www.pexels.com/api/  and  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: local Ollama server (default http://127.0.0.1:11434)
OLLAMA_HOST=

# Optional: override where large artifacts live. Must NOT be inside a
# OneDrive/Dropbox-synced folder. Defaults to <repo>/data
CLIPPER_DATA_DIR=

# Campaign watcher (`clipper watch`). A mailbox used ONLY for forwarded
# Vyro/Whop campaign emails -- not your personal inbox. For Gmail, turn on
# 2-step verification and create an app password at
# https://myaccount.google.com/apppasswords
WATCH_EMAIL=
WATCH_EMAIL_APP_PASSWORD=
# ntfy topic your phone subscribes to (free app, https://ntfy.sh). Anyone who
# knows the name can read it, so keep the random suffix.
NTFY_TOPIC=

# TikTok Display API (`clipper tiktok login` / `sync`): fills the performance
# log with your own posts' views, likes, comments and shares. From your app at
# https://developers.tiktok.com (Manage apps -> your app, sandbox is fine).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
