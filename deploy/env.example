# Copy to deploy/.env and fill in. Never commit .env. Lines left empty are off.

# --- site ---
# The domain Caddy serves, no https:// (for example clip.example.com).
CLIPPER_DOMAIN=
# The full public address, with https:// (links in emails, Paddle return pages).
CLIPPER_PUBLIC_URL=
# Comma-separated sign-in emails that get /admin.
CLIPPER_ADMINS=
# Shown on the legal pages and in emails.
CLIPPER_CONTACT_EMAIL=
# Largest single upload in GB.
CLIPPER_MAX_UPLOAD_GB=
# Outgoing email for resets and receipts: smtp[s]://user:pass@host:port
SMTP_URL=
# Optional error reports (needs sentry-sdk installed in the image; not included by default).
SENTRY_DSN=

# --- shared AI and stock keys (every user's process uses these) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Transcription on the hosted site.
GROQ_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
COVERR_API_KEY=

# --- Paddle ---
# sandbox or production
PADDLE_ENV=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_AGENCY_MONTHLY=
PADDLE_PRICE_AGENCY_YEARLY=
# One-off packs: one campaign, 300 minutes, 5 Shorts.
PADDLE_PRICE_PACK_CAMPAIGN=
PADDLE_PRICE_PACK_MINUTES=
PADDLE_PRICE_PACK_SHORTS=

# --- compose only ---
# Host folder for backups (default /srv/clipper-backups).
BACKUP_DIR=
